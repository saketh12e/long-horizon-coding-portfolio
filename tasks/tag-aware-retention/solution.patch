+
+    def set_decay_rate_for_tag(self, tag: str, rate: float) -> None:
+        """Configure a custom decay rate for memories carrying *tag*.
+
+        Parameters
+        ----------
+        tag:
+            The tag name (e.g. ``"ephemeral"`` or ``"permanent"``). Lookups
+            are exact, case-sensitive matches against ``item.tags``.
+        rate:
+            The decay rate to apply, expressed as a probability per day
+            and clamped to the same ``[0.0, 1.0]`` domain as the default
+            ``rate`` constructor argument.
+
+        Raises
+        ------
+        ValueError
+            If ``tag`` is empty/blank, or if ``rate`` is outside ``[0.0, 1.0]``.
+        """
+        if tag is None or not str(tag).strip():
+            raise ValueError("Tag must be a non-empty string")
+        if not (0.0 <= float(rate) <= 1.0):
+            raise ValueError(f"Decay rate must be in [0.0, 1.0], got {rate!r}")
+        self._tag_decay_rates[str(tag)] = float(rate)
+
+    def get_decay_rate_for_tag(self, tag: str) -> Optional[float]:
+        """Return the configured rate for *tag*, or ``None`` when unconfigured."""
+        if not tag:
+            return None
+        return self._tag_decay_rates.get(tag)
+
+    def list_decay_tag_rates(self) -> dict[str, float]:
+        """Return a copy of every configured ``{tag: rate}`` mapping."""
+        return dict(self._tag_decay_rates)
+
+    def clear_decay_rate_for_tag(self, tag: str) -> bool:
+        """Remove the rate mapping for *tag*. Returns ``True`` if it existed."""
+        return self._tag_decay_rates.pop(tag, None) is not None
+
