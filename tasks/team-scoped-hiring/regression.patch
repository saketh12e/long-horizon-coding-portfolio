+    db_dir.mkdir(parents=True, exist_ok=True)
+    _reload_database_for_dir(db_dir)
+
+    from database import clear_database, init_db
+    from database.connection import get_session
+    from database.models import Team
+
+    init_db()
+    clear_database()
+
+    session = get_session()
+    try:
+        session.add(
+            Team(
+                id=1,
+                name="Harbor Hawks",
+                city="Harbor",
+                abbr="HK1",
+                color="#111111",
+                offense_rating=80,
+                defense_rating=80,
+                overall_rating=80,
