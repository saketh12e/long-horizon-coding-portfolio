+async fn prepare_row_tracking_payload(
+    data: &CommitData,
+    committer: &dyn Committer,
+    store: ObjectStoreRef,
+    retries: u64,
+) -> DeltaResult<CommitOrBytes> {
+    let mut bytes = data.get_bytes()?;
+    if retries > 0 {
+        bytes = CommitData::update_retry_count_in_bytes(&bytes, retries)?;
+    }
+    match committer.payload_kind() {
+        PayloadKind::Bytes => Ok(CommitOrBytes::LogBytes(bytes)),
+        PayloadKind::TmpCommit => {
+            let token = uuid::Uuid::new_v4().to_string();
+            let path = Path::from_iter([DELTA_LOG_FOLDER, &format!("_commit_{token}.json.tmp")]);
+            store.put(&path, bytes.into()).await?;
+            Ok(CommitOrBytes::TmpCommit(path))
+        }
+    }
+}
