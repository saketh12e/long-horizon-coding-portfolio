+class TestGmEligibleTargetsApi:
+    def test_eligible_targets_exposes_team_scoped_coach_candidates(self, coach_hire_db):
+        _import_coach_candidate_model()
+        main = _api_main()
+
+        data = coach_hire_db
+        team = data["teams"][0]
+        season = data["season"]
+        session = data["session_factory"]()
+        try:
+            _generate_team_hire_slate(
+                data["team_manager"], team, season, session=session
+            )
+            session.commit()
+
+            class _Season:
+                seasonNumber = season
+
+            fake_app = SimpleNamespace(
+                seasonManager=SimpleNamespace(currentSeason=_Season()),
+                serviceContainer=SimpleNamespace(
+                    getService=lambda name: data["team_manager"]
+                    if name == "team_manager"
+                    else None
+                ),
+            )
+            data["team_manager"].teams = [team]
+            monkeypatch_targets = pytest.MonkeyPatch()
+            monkeypatch_targets.setattr(main, "simulation_app", fake_app)
+            monkeypatch_targets.setattr(main, "_getCurrentUser", lambda: SimpleNamespace(id=1))
+
+            resp = main.get_gm_eligible_targets(teamId=team.id, user=SimpleNamespace(id=1))
+            monkeypatch_targets.undo()
+        finally:
+            session.close()
+
+        assert resp["success"] is True
+        payload = resp["data"]
+        assert "coachCandidates" in payload, (
+            "GM eligible targets must return per-team coachCandidates, not a league pool"
+        )
+        assert "availableCoaches" not in payload
+        assert len(payload["coachCandidates"]) == 3
+        assert all(c["id"] for c in payload["coachCandidates"])
+
