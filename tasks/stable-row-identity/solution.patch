+/// Group using logical partition names, while resolving name-mapped log keys
+/// through the physical field names. The writer translates the keys back when
+/// emitting Add actions.
+fn optimize_partition_values(
+    file: &LogicalFileView,
+    partition_columns: &[String],
+    snapshot: &EagerSnapshot,
+) -> DeltaResult<IndexMap<String, Scalar>> {
+    let schema = snapshot.schema();
+    let mode = snapshot.table_configuration().column_mapping_mode();
+    if mode == ColumnMappingMode::None {
+        return file.full_partition_values(partition_columns, schema.as_ref());
+    }
+    let raw_values = file.partition_values_map();
+    let mut values = IndexMap::with_capacity(partition_columns.len());
+    for name in partition_columns {
+        let field = schema
+            .field(name)
+            .ok_or_else(|| DeltaTableError::SchemaMismatch {
+                msg: format!("Partition column '{name}' is not present in table schema"),
+            })?;
+        let primitive = field.data_type().as_primitive_opt().ok_or_else(|| {
+            DeltaTableError::SchemaMismatch {
+                msg: format!("Partition column '{name}' is not primitive"),
+            }
+        })?;
+        let value = match raw_values.get(field.physical_name(mode)) {
+            Some(Some(raw)) => primitive.parse_scalar(raw)?,
+            Some(None) => Scalar::Null(field.data_type().clone()),
+            None => {
+                return Err(DeltaTableError::SchemaMismatch {
+                    msg: format!(
+                        "Add action for optimized file is missing physical partition value for '{name}'"
+                    ),
+                });
+            }
+        };
+        values.insert(name.clone(), value);
+    }
+    Ok(values)
+}
