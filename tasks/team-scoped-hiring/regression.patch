+class TestPerTeamHireResolution:
+    def test_resolve_hire_uses_plurality_within_team_slate(self, coach_hire_db):
+        CoachCandidate = _import_coach_candidate_model()
+        from database.models import Coach as DBCoach
+
+        data = coach_hire_db
+        team = data["teams"][0]
+        season = data["season"]
+        session = data["session_factory"]()
+        try:
+            cands = _generate_team_hire_slate(
+                data["team_manager"], team, season, session=session
+            )
+            session.flush()
+            winner = cands[1]
+            gm = _gm_with_votes({1: [_fake_vote(winner.coach_id, 5)], "_session": session})
+            gm.resolveHireCoachVotes(
+                data["teams"], season, data["team_manager"], {team.id}
+            )
+            session.flush()
+            hired_id = session.query(DBCoach).filter_by(team_id=team.id).first().id
+            remaining = (
+                session.query(CoachCandidate)
+                .filter_by(team_id=team.id, season=season)
+                .count()
+            )
+        finally:
+            session.close()
+
+        assert hired_id == winner.coach_id
+        assert remaining == 0
+
+    def test_resolve_ignores_votes_outside_team_slate(self, coach_hire_db):
+        _import_coach_candidate_model()
+        from database.models import Coach as DBCoach
+
+        data = coach_hire_db
+        team = data["teams"][0]
+        season = data["season"]
+        session = data["session_factory"]()
+        try:
+            cands = _generate_team_hire_slate(
+                data["team_manager"], team, season, session=session
+            )
+            session.flush()
+            outsider = 999_001
+            default_pick = sorted(
+                cands, key=lambda c: (-c.coach.overall_rating, c.coach_id)
+            )[0]
+            gm = _gm_with_votes({1: [_fake_vote(outsider, 99)], "_session": session})
+            gm.resolveHireCoachVotes(
+                data["teams"], season, data["team_manager"], {team.id}
+            )
+            session.flush()
+            hired = session.query(DBCoach).filter_by(team_id=team.id).first()
+        finally:
+            session.close()
+
+        assert hired.id == default_pick.coach_id
+
+    def test_resolve_no_votes_defaults_to_highest_rated_candidate(self, coach_hire_db):
+        _import_coach_candidate_model()
+        from database.models import Coach as DBCoach
+
+        data = coach_hire_db
