+class TestCoachCandidatePersistence:
+    def test_coach_candidates_persist_for_team_and_season(self, coach_hire_db):
+        from sqlalchemy import inspect
+
+        CoachCandidate = _import_coach_candidate_model()
+        data = coach_hire_db
+        team = data["teams"][0]
+        season = data["season"]
+        session = data["session_factory"]()
+        try:
+            rows = _generate_team_hire_slate(
+                data["team_manager"], team, season, session=session
+            )
+            session.commit()
+            table_names = inspect(session.bind).get_table_names()
+            count = (
+                session.query(CoachCandidate)
+                .filter_by(team_id=team.id, season=season)
+                .count()
+            )
+        finally:
+            session.close()
+
+        assert "coach_candidates" in table_names
+        assert len(rows) == 3
+        assert count == 3
+
+    def test_generate_coach_candidates_creates_three_rows(self, coach_hire_db):
+        CoachCandidate = _import_coach_candidate_model()
+        data = coach_hire_db
+        tm = data["team_manager"]
+        team = data["teams"][0]
+        season = data["season"]
+        session = data["session_factory"]()
+        try:
+            rows = _generate_team_hire_slate(tm, team, season, session=session)
+            ratings = sorted(c.coach.overall_rating for c in rows)
+            session.commit()
+            count = (
+                session.query(CoachCandidate)
+                .filter_by(team_id=team.id, season=season)
+                .count()
+            )
+        finally:
+            session.close()
+
+        assert len(rows) == 3
+        assert count == 3
+        assert ratings[-1] >= ratings[0]
+
+    def test_generate_coach_candidates_idempotent(self, coach_hire_db):
+        _import_coach_candidate_model()
+        data = coach_hire_db
+        tm = data["team_manager"]
+        team = data["teams"][0]
+        season = data["season"]
+        session = data["session_factory"]()
+        try:
+            first = _generate_team_hire_slate(tm, team, season, session=session)
+            first_ids = [c.coach_id for c in first]
+            second = _generate_team_hire_slate(tm, team, season, session=session)
+            second_ids = [c.coach_id for c in second]
+            session.commit()
+        finally:
+            session.close()
+
+        assert len(first) == 3
+        assert first_ids == second_ids
+
+    def test_three_coach_slate_has_premium_to_developmental_spread(
+        self, coach_hire_db, monkeypatch
+    ):
+        import random
+
+        import numpy as np
+
+        monkeypatch.setattr(random, "shuffle", lambda items: None)
+        monkeypatch.setattr(
+            np.random,
+            "normal",
+            lambda loc, scale, size=None: (
+                np.array(loc) if size is None else np.full(size, loc)
+            ),
+        )
+
+        data = coach_hire_db
+        team = data["teams"][0]
+        season = data["season"]
+        session = data["session_factory"]()
+        try:
+            rows = _generate_team_hire_slate(
+                data["team_manager"], team, season, session=session
+            )
+            ratings = sorted(c.coach.overall_rating for c in rows)
+        finally:
+            session.close()
+
+        assert len(ratings) == 3
+        assert ratings == [72, 80, 90]
