new file mode 100644
index 0000000..5a198cc
--- /dev/null
+++ b/crates/core/tests/row_tracking_api.rs
@@ -0,0 +1,110 @@
+#![cfg(feature = "datafusion")]
+
+use std::collections::HashSet;
+use std::sync::Arc;
+
+use arrow::array::{Array, Int64Array, StringArray};
+use arrow::record_batch::RecordBatch;
+use arrow_schema::{DataType, Field, Schema};
+use deltalake_core::DeltaTable;
+use futures::TryStreamExt;
+
+type TestResult = Result<(), Box<dyn std::error::Error>>;
+
+fn batch() -> RecordBatch {
+    RecordBatch::try_new(
+        Arc::new(Schema::new(vec![
+            Field::new("value", DataType::Int64, true),
+            Field::new("label", DataType::Utf8, true),
+        ])),
+        vec![
+            Arc::new(Int64Array::from(vec![Some(7), Some(7), None])),
+            Arc::new(StringArray::from(vec![Some("same"), Some("same"), None])),
+        ],
+    )
+    .unwrap()
+}
+
+#[tokio::test]
+async fn native_tracked_scan_projects_users_then_nonnullable_metadata() -> TestResult {
+    let table = DeltaTable::new_in_memory().write(vec![batch()]).await?;
+    let table = table.enable_row_tracking().await?;
+    let version = table.version().unwrap();
+    let (_, stream) = table
+        .scan_table()
+        .with_columns(["label"])
+        .with_row_tracking(true)
+        .await?;
+    let schema = stream.schema();
+    assert_eq!(
+        schema
+            .fields()
+            .iter()
+            .map(|f| f.name().as_str())
+            .collect::<Vec<_>>(),
+        ["label", "__delta_row_id", "__delta_row_commit_version"]
+    );
+    for name in ["__delta_row_id", "__delta_row_commit_version"] {
+        let field = schema.field_with_name(name)?;
+        assert_eq!(field.data_type(), &DataType::Int64);
+        assert!(!field.is_nullable());
+    }
+    let batches: Vec<RecordBatch> = stream.try_collect().await?;
+    let mut ids = HashSet::new();
+    let mut labels = Vec::new();
+    for batch in batches {
+        let row_ids = batch
+            .column(1)
+            .as_any()
+            .downcast_ref::<Int64Array>()
+            .unwrap();
+        let versions = batch
+            .column(2)
+            .as_any()
+            .downcast_ref::<Int64Array>()
+            .unwrap();
+        assert_eq!(row_ids.null_count(), 0);
+        assert_eq!(versions.null_count(), 0);
+        for row in 0..batch.num_rows() {
+            assert!(ids.insert(row_ids.value(row)));
+            assert!(row_ids.value(row) >= 0);
+            assert_eq!(versions.value(row), version as i64);
+        }
+        labels.extend((0..batch.num_rows()).map(|row| !batch.column(0).is_null(row)));
+    }
+    assert_eq!(ids.len(), 3);
+    assert_eq!(labels.iter().filter(|&&valid| valid).count(), 2);
+    let (_, ordinary) = table.scan_table().await?;
+    assert_eq!(ordinary.schema().fields().len(), 2);
+    let again = table.enable_row_tracking().await?;
+    assert_eq!(again.version(), Some(version));
+    Ok(())
+}
+
+#[tokio::test]
+async fn native_tracking_request_on_unenabled_table_is_an_error() -> TestResult {
+    let table = DeltaTable::new_in_memory().write(vec![batch()]).await?;
+    assert!(table.scan_table().with_row_tracking(true).await.is_err());
+    let (_, stream) = table.scan_table().await?;
+    let batches: Vec<RecordBatch> = stream.try_collect().await?;
+    assert_eq!(batches.iter().map(RecordBatch::num_rows).sum::<usize>(), 3);
+    Ok(())
+}
+
+#[tokio::test]
+async fn native_metadata_only_projection_keeps_every_logical_row() -> TestResult {
+    let table = DeltaTable::new_in_memory()
+        .write(vec![batch()])
+        .await?
+        .enable_row_tracking()
+        .await?;
+    let (_, stream) = table
+        .scan_table()
+        .with_columns(Vec::<String>::new())
+        .with_row_tracking(true)
+        .await?;
+    assert_eq!(stream.schema().fields().len(), 2);
+    let batches: Vec<RecordBatch> = stream.try_collect().await?;
+    assert_eq!(batches.iter().map(RecordBatch::num_rows).sum::<usize>(), 3);
+    Ok(())
+}
