+
+def _gm_with_votes(votes_by_team: dict[int, list]):
+    from managers.gmManager import GmManager
+
+    session = votes_by_team.get("_session")
+    gm = GmManager(session)
+    gm.voteRepo = _VoteRepoStub({k: v for k, v in votes_by_team.items() if k != "_session"})
+    return gm
+
