+"""Behavioral regression tests for team-scoped hiring workflow."""
+
+from __future__ import annotations
+
+import importlib
+import os
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+_TEST_FILE = Path(__file__).resolve()
+REPO_ROOT = None
+for _candidate in (
+    Path.cwd().resolve(),
+    Path("/app/simulation"),
+    Path("/workspace"),
+    *_TEST_FILE.parents,
+):
+    if (_candidate / "managers" / "gmManager.py").exists() and (
+        _candidate / "managers" / "teamManager.py"
+    ).exists():
+        REPO_ROOT = _candidate
+        break
+if REPO_ROOT is None:
+    REPO_ROOT = Path.cwd().resolve()
+
+os.environ.setdefault("LOG_TO_FILE", "0")
+os.environ.setdefault("TIMING_MODE", "fast")
+
+if str(REPO_ROOT) not in sys.path:
+    sys.path.insert(0, str(REPO_ROOT))
+
+
+def _api_main():
+    os.environ.setdefault("DATABASE_DIR", "/tmp/gm-coach-verifier")
+    import api.main as main_mod
+
+    return main_mod
+
+
+def _reload_database_for_dir(db_dir: Path):
+    import importlib
+
+    os.environ["DATABASE_DIR"] = str(db_dir)
+    import database.connection as conn
+
+    if conn.engine is not None:
+        conn.engine.dispose()
+    importlib.reload(conn)
+    return conn
+
+
+def _fake_team(team_id: int, name: str, tier: str = "MID_MARKET"):
+    return SimpleNamespace(
+        id=team_id,
+        name=name,
+        fundingTier=tier,
+        coach_id=None,
+        coach=None,
+    )
+
+
+def _fake_vote(target_id: int, count: int = 1):
+    return SimpleNamespace(target_player_id=target_id, votes=count)
+
+
+class _VoteRepoStub:
+    def __init__(self, votes_by_team: dict[int, list]):
+        self._votes = votes_by_team
+
+    def getVotesForTeam(self, team_id: int, season: int, vote_type: str):
+        if vote_type != "hire_coach":
+            return []
+        return self._votes.get(team_id, [])
+
+    def getTeamFanCount(self, team_id: int, season: int) -> int:
+        return 10
+
+    def recordResult(self, **kwargs):
+        return None
+
+
+@pytest.fixture()
