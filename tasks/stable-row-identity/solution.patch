+/// Translate metadata output names to the table's physical materialized names.
+/// NULL values intentionally survive this projection: commit preparation assigns
+/// the file defaults at the successful commit, including after retry.
+pub(crate) fn materialize_row_tracking_plan(
+    table_config: &TableConfiguration,
+    plan: Arc<dyn ExecutionPlan>,
+) -> DeltaResult<Arc<dyn ExecutionPlan>> {
+    if !row_tracking::is_enabled(table_config.table_properties()) {
+        return Ok(plan);
+    }
+    let (row_id, version) =
+        row_tracking::materialized_column_names(table_config.table_properties())?;
+    let schema = plan.schema();
+    let has_id = schema.column_with_name(ROW_ID_COLUMN).is_some();
+    let has_version = schema.column_with_name(ROW_COMMIT_VERSION_COLUMN).is_some();
+    if has_id != has_version {
+        return Err(DeltaTableError::InvalidData {
+            message: "row tracking rewrite must carry both metadata columns".into(),
+        });
+    }
+    // Ordinary inserts need no materialized columns; Add defaults give them fresh identity.
+    if !has_id {
+        return Ok(plan);
+    }
+    let expressions = schema
+        .fields()
+        .iter()
+        .map(|field| {
+            let name = match field.name().as_str() {
+                ROW_ID_COLUMN => row_id,
+                ROW_COMMIT_VERSION_COLUMN => version,
+                name => name,
+            };
+            Ok((physical_col(field.name(), &schema)?, name.to_owned()))
+        })
+        .collect::<DeltaResult<Vec<_>>>()?;
+    Ok(Arc::new(ProjectionExec::try_new(expressions, plan)?))
+}
+
+pub(crate) fn materialized_row_tracking_schema(
+    table_config: &TableConfiguration,
+    schema: &arrow_schema::SchemaRef,
+) -> DeltaResult<arrow_schema::SchemaRef> {
+    if !row_tracking::is_enabled(table_config.table_properties()) {
+        return Ok(schema.clone());
+    }
+    let (row_id, version) =
+        row_tracking::materialized_column_names(table_config.table_properties())?;
+    let fields = schema
+        .fields()
+        .iter()
+        .map(|field| {
+            let name = match field.name().as_str() {
+                ROW_ID_COLUMN => row_id,
+                ROW_COMMIT_VERSION_COLUMN => version,
+                name => name,
+            };
+            field.as_ref().clone().with_name(name)
+        })
+        .collect::<Vec<_>>();
+    Ok(Arc::new(Schema::new_with_metadata(
+        fields,
+        schema.metadata().clone(),
+    )))
+}
