+            .await?;
+        let left = table.clone().write(vec![batch.clone()]);
+        let right = table.clone().write(vec![batch]);
+        let (left, right) = tokio::join!(left.into_future(), right.into_future());
+        let left = left?;
+        let right = right?;
+        assert_ne!(left.version(), right.version());
+        let mut table = table;
+        table.load().await?;
+        let adds = table
+            .snapshot()?
