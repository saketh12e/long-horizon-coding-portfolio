+            .snapshot()
+            .active_adds(
+                table.log_store().as_ref(),
+                ActiveAddOptions {
+                    predicate: None,
+                    stats: AddStatsPolicy::RawJson,
+                },
+            )
+            .try_collect::<Vec<_>>()
+            .await?;
+        let mut ids = std::collections::HashSet::new();
+        let mut versions = std::collections::HashSet::new();
+        for file in adds {
+            let add = file.to_add();
+            let base = add.base_row_id.expect("committed base");
+            versions.insert(add.default_row_commit_version.expect("committed version"));
+            for offset in 0..num_records(&add)?.expect("statistics") {
