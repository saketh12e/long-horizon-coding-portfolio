+/// Rescan the selected files with stable metadata before any row filter is applied.
+/// File discovery remains an ordinary user-data scan; only the rewrite needs the
+/// hidden columns, and the provider reconstructs them using physical ordinals.
+pub(crate) fn row_tracking_rewrite_scan(
+    session: &dyn Session,
+    snapshot: &Snapshot,
+    log_store: LogStoreRef,
+    files: &MatchedFilesScan,
+) -> DeltaResult<LogicalPlan> {
+    if !row_tracking::is_enabled(snapshot.table_properties()) {
+        return Ok(files.scan().clone());
+    }
+    let provider = DeltaScanNext::new(
+        snapshot.clone(),
+        DeltaScanConfig::new_from_session(session).with_row_tracking(true),
+    )?
+    .with_log_store(log_store)
+    .with_file_paths(files.files_set());
+    Ok(
+        LogicalPlanBuilder::scan("source", provider_as_source(Arc::new(provider)), None)?
+            .build()?,
+    )
+}
