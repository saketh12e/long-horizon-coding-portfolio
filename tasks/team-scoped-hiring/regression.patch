+def _import_coach_candidate_model():
+    try:
+        from database.models import CoachCandidate
+    except ImportError:
+        pytest.fail("Per-team hire slates need persisted coach-candidate rows")
+    return CoachCandidate
+
+
+def _generate_team_hire_slate(tm, team, season, session):
+    try:
+        return tm.generateCoachCandidates(team, season, session=session)
+    except AttributeError:
+        pytest.fail("Team manager cannot generate the per-team three-coach hire slate")
+
+
+def _clear_team_hire_slate(tm, team_id, season, session, *, keep_coach_id):
+    try:
+        return tm.clearCoachCandidates(
+            team_id, season, keepCoachId=keep_coach_id, session=session
+        )
+    except AttributeError:
+        pytest.fail("Team manager cannot clear a resolved per-team hire slate")
+
