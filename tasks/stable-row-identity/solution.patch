+/// Reconstruct metadata before any row selection. Physical positions are zero based
+/// and are counted on unsplit, unfiltered file input across row groups and batches.
+fn reconstruct_row_tracking(
+    tracking: &super::plan::RowTrackingContext,
+    batch: &RecordBatch,
+    file_id: &str,
+    positions: &arrow_array::Int64Array,
+) -> Result<RecordBatch> {
+    use crate::kernel::row_tracking::{ROW_COMMIT_VERSION_COLUMN, ROW_ID_COLUMN};
+    use arrow_array::Int64Array;
+
+    let (base, default_version) = tracking.defaults.get(file_id).copied().ok_or_else(|| {
+        DataFusionError::Execution(format!(
+            "missing row tracking defaults for file '{file_id}'"
+        ))
+    })?;
+    if base < 0 || default_version < 0 {
+        return exec_err!("negative row tracking defaults");
+    }
+    let int64_column = |name: &str| -> Result<&Int64Array> {
+        batch
+            .column_by_name(name)
+            .and_then(|array| array.as_any().downcast_ref::<Int64Array>())
+            .ok_or_else(|| {
+                DataFusionError::Execution(format!("row tracking column '{name}' must be Int64"))
+            })
+    };
+    let materialized_ids = int64_column(&tracking.materialized_row_id)?;
+    let materialized_versions = int64_column(&tracking.materialized_commit_version)?;
+    let mut ids = Vec::with_capacity(batch.num_rows());
+    let mut versions = Vec::with_capacity(batch.num_rows());
+    for row in 0..batch.num_rows() {
+        if positions.is_null(row) || positions.value(row) < 0 {
+            return exec_err!("invalid physical position for row tracking");
+        }
+        let id = if materialized_ids.is_valid(row) {
+            materialized_ids.value(row)
+        } else {
+            base.checked_add(positions.value(row)).ok_or_else(|| {
+                DataFusionError::Execution("row ID reconstruction overflow".into())
+            })?
+        };
+        let version = if materialized_versions.is_valid(row) {
+            materialized_versions.value(row)
+        } else {
+            default_version
+        };
+        if id < 0 || version < 0 {
+            return exec_err!("negative materialized row ID or row commit version");
+        }
+        ids.push(id);
+        versions.push(version);
+    }
+    Ok(RecordBatch::try_new(
+        Arc::new(Schema::new(vec![
+            arrow_schema::Field::new(ROW_ID_COLUMN, arrow_schema::DataType::Int64, false),
+            arrow_schema::Field::new(
+                ROW_COMMIT_VERSION_COLUMN,
+                arrow_schema::DataType::Int64,
+                false,
+            ),
+        ])),
+        vec![
+            Arc::new(Int64Array::from(ids)),
+            Arc::new(Int64Array::from(versions)),
+        ],
+    )?)
+}
