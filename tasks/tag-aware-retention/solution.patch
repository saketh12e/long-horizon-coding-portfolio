+
+        The first tag in ``item.tags`` that has a configured rate wins.
+        A memory with no matching tag falls back to the default ``self.rate``.
+        """
+        for tag in item.tags or ():
+            if tag in self._tag_decay_rates:
+                return self._tag_decay_rates[tag]
+        return self.rate
 
