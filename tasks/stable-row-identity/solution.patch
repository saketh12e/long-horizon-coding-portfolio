new file mode 100644
index 0000000..a4472d1
--- /dev/null
+++ b/crates/core/src/kernel/row_tracking.rs
@@ -0,0 +1,736 @@
+//! Protocol allocation and validation for native stable row tracking.
+
+use std::collections::HashMap;
+use std::time::{Duration, Instant};
+
+use delta_kernel::table_features::TableFeature;
+use delta_kernel::table_properties::TableProperties;
+use futures::TryStreamExt;
+use object_store::{ObjectStore as _, ObjectStoreExt as _};
+use serde::Deserialize;
+
+use crate::errors::{DeltaResult, DeltaTableError};
+use crate::kernel::{
+    Action, ActiveAddOptions, Add, AddStatsPolicy, DomainMetadata, EagerSnapshot, Metadata,
+    MetadataExt as _, Protocol, ProtocolInner, Version,
+};
+use crate::logstore::{LogStore, get_actions};
+use crate::protocol::checkpoints::parse_last_checkpoint_hint;
+
+/// Public stable row identity output column.
+pub const ROW_ID_COLUMN: &str = "__delta_row_id";
+/// Public last-update version output column.
+pub const ROW_COMMIT_VERSION_COLUMN: &str = "__delta_row_commit_version";
+/// Domain storing the committed allocation high-water mark.
+pub const ROW_TRACKING_DOMAIN: &str = "delta.rowTracking";
+/// Property enabling stable identity preservation.
+pub const ENABLE_ROW_TRACKING: &str = "delta.enableRowTracking";
+/// Unsupported suspension property.
+pub const ROW_TRACKING_SUSPENDED: &str = "delta.rowTrackingSuspended";
+/// Property naming the physical materialized identity column.
+pub const MATERIALIZED_ROW_ID_COLUMN: &str = "delta.rowTracking.materializedRowIdColumnName";
+/// Property naming the physical materialized version column.
+pub const MATERIALIZED_ROW_COMMIT_VERSION_COLUMN: &str =
+    "delta.rowTracking.materializedRowCommitVersionColumnName";
+/// Opt-in directory for documented deterministic commit barriers.
+pub const FAILPOINT_ENV: &str = "DELTALAKE_ROW_TRACKING_FAILPOINT_DIR";
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct RowTrackingDomainConfiguration {
+    row_id_high_water_mark: i64,
+}
+
+fn invalid(message: impl Into<String>) -> DeltaTableError {
+    DeltaTableError::InvalidData {
+        message: message.into(),
+    }
+}
+
+pub(crate) fn is_supported(protocol: &Protocol) -> bool {
+    protocol
+        .writer_features()
+        .is_some_and(|features| features.contains(&TableFeature::RowTracking))
+}
+
+pub(crate) fn is_enabled(properties: &TableProperties) -> bool {
+    properties.enable_row_tracking == Some(true)
+}
+
+pub(crate) fn materialized_column_names(properties: &TableProperties) -> DeltaResult<(&str, &str)> {
+    let row_id = properties
+        .materialized_row_id_column_name
+        .as_deref()
+        .ok_or_else(|| invalid("row tracking has no materialized row ID column name"))?;
+    let version = properties
+        .materialized_row_commit_version_column_name
+        .as_deref()
+        .ok_or_else(|| {
+            invalid("row tracking has no materialized row commit version column name")
+        })?;
+    if row_id.is_empty() || version.is_empty() || row_id == version {
+        return Err(invalid(
+            "row tracking materialized column names must be nonempty and distinct",
+        ));
+    }
+    Ok((row_id, version))
+}
+
+fn validate_schema(metadata: &Metadata) -> DeltaResult<()> {
+    let schema = metadata.parse_schema()?;
+    let configured: Vec<&str> = [
+        MATERIALIZED_ROW_ID_COLUMN,
+        MATERIALIZED_ROW_COMMIT_VERSION_COLUMN,
+    ]
+    .iter()
+    .filter_map(|key| metadata.configuration().get(*key).map(String::as_str))
+    .collect();
+    for field in schema.fields() {
+        let logical = field.name().as_str();
+        if [ROW_ID_COLUMN, ROW_COMMIT_VERSION_COLUMN].contains(&logical) {
+            return Err(invalid(format!(
+                "user column '{logical}' is reserved for row tracking"
+            )));
+        }
+        let physical = match field.metadata().get("delta.columnMapping.physicalName") {
+            Some(delta_kernel::schema::MetadataValue::String(name)) => Some(name.as_str()),
+            _ => None,
+        };
+        if configured
+            .iter()
+            .any(|name| *name == logical || Some(*name) == physical)
+        {
+            return Err(invalid(format!(
+                "materialized row tracking column collides with user column '{logical}'"
+            )));
+        }
+    }
+    Ok(())
+}
+
+pub(crate) fn enablement_actions(
+    protocol: &Protocol,
+    metadata: &Metadata,
+) -> DeltaResult<(Protocol, Metadata)> {
+    validate_schema(metadata)?;
+    let protocol = ProtocolInner::from_kernel(protocol)
+        .append_writer_features([TableFeature::RowTracking, TableFeature::DomainMetadata])
+        .as_kernel();
+    let mut metadata = metadata
+        .clone()
+        .add_config_key(ENABLE_ROW_TRACKING.to_owned(), "true".to_owned())?;
+    if !metadata
+        .configuration()
+        .contains_key(MATERIALIZED_ROW_ID_COLUMN)
+    {
+        metadata = metadata.add_config_key(
+            MATERIALIZED_ROW_ID_COLUMN.to_owned(),
+            format!("_row_id_{}", uuid::Uuid::new_v4().simple()),
+        )?;
+    }
+    if !metadata
+        .configuration()
+        .contains_key(MATERIALIZED_ROW_COMMIT_VERSION_COLUMN)
+    {
+        metadata = metadata.add_config_key(
+            MATERIALIZED_ROW_COMMIT_VERSION_COLUMN.to_owned(),
+            format!("_row_commit_version_{}", uuid::Uuid::new_v4().simple()),
+        )?;
+    }
+    Ok((protocol, metadata))
+}
+
+fn configured_bool(metadata: &Metadata, key: &str) -> DeltaResult<Option<bool>> {
+    metadata
+        .configuration()
+        .get(key)
+        .map(|value| {
+            value
+                .parse::<bool>()
+                .map_err(|_| invalid(format!("invalid boolean value for {key}: {value}")))
+        })
+        .transpose()
+}
+
+fn metadata_with_names(snapshot: Option<&EagerSnapshot>, actions: &[Action]) -> Option<Metadata> {
+    actions
+        .iter()
+        .rev()
+        .find_map(|action| match action {
+            Action::Metadata(metadata) => Some(metadata.clone()),
+            _ => None,
+        })
+        .or_else(|| snapshot.map(|snapshot| snapshot.metadata().clone()))
+}
+
+fn protocol_with_features(
+    snapshot: Option<&EagerSnapshot>,
+    actions: &[Action],
+) -> Option<Protocol> {
+    actions
+        .iter()
+        .rev()
+        .find_map(|action| match action {
+            Action::Protocol(protocol) => Some(protocol.clone()),
+            _ => None,
+        })
+        .or_else(|| snapshot.map(|snapshot| snapshot.protocol().clone()))
+}
+
+fn num_records(add: &Add) -> DeltaResult<Option<i64>> {
+    let Some(stats) = &add.stats else {
+        return Ok(None);
+    };
+    let stats: serde_json::Value = serde_json::from_str(stats)
+        .map_err(|err| invalid(format!("invalid Add statistics for row tracking: {err}")))?;
+    stats
+        .get("numRecords")
+        .map(|value| {
+            value
+                .as_i64()
+                .filter(|count| *count >= 0)
+                .ok_or_else(|| invalid("Add numRecords must be a nonnegative Int64"))
+        })
+        .transpose()
+}
+
+async fn records_for_allocation(add: &Add, log_store: &dyn LogStore) -> DeltaResult<i64> {
+    if let Some(count) = num_records(add)? {
+        return Ok(count);
+    }
+    let path = object_store::path::Path::parse(&add.path)?;
+    let reader =
+        crate::logstore::parquet_reader::ParquetObjectReader::new(log_store.object_store(), path);
+    let builder =
+        parquet::arrow::async_reader::ParquetRecordBatchStreamBuilder::new(reader).await?;
+    let count = builder.metadata().file_metadata().num_rows();
+    if count < 0 {
+        return Err(invalid("negative Parquet row count"));
+    }
+    Ok(count)
+}
+
+fn advance_high_water_mark(hwm: &mut i64, count: i64) -> DeltaResult<()> {
+    *hwm = hwm
+        .checked_add(count)
+        .ok_or_else(|| invalid("row ID high-water mark overflow"))?;
+    Ok(())
+}
+
+async fn backfill_active_files(
+    snapshot: &EagerSnapshot,
+    log_store: &dyn LogStore,
+    actions: &mut Vec<Action>,
+) -> DeltaResult<()> {
+    let mut add_indices = HashMap::new();
+    for (index, action) in actions.iter().enumerate() {
+        if let Action::Add(add) = action {
+            add_indices.insert(add.path.clone(), index);
+        }
+    }
+
+    let active_files = snapshot
+        .snapshot()
+        .active_adds(
+            log_store,
+            ActiveAddOptions {
+                predicate: None,
+                stats: AddStatsPolicy::RawJson,
+            },
+        )
+        .try_collect::<Vec<_>>()
+        .await?;
+    for file in active_files {
+        let mut file_add = file.to_add();
+        if file_add.base_row_id.is_some() && file_add.default_row_commit_version.is_some() {
+            continue;
+        }
+        if let Some(index) = add_indices.get(&file_add.path).copied() {
+            let Action::Add(add) = &mut actions[index] else {
+                unreachable!("Add index must reference an Add action")
+            };
+            add.data_change = false;
+        } else {
+            file_add.data_change = false;
+            actions.push(Action::Add(file_add));
+        }
+    }
+    Ok(())
+}
+
+async fn last_checkpoint_version(log_store: &dyn LogStore) -> DeltaResult<Option<Version>> {
+    let path = log_store.log_path().clone().join("_last_checkpoint");
+    let data = match log_store.object_store().get(&path).await {
+        Ok(data) => data.bytes().await?,
+        Err(object_store::Error::NotFound { .. }) => return Ok(None),
+        Err(err) => return Err(err.into()),
+    };
+    Ok(parse_last_checkpoint_hint(&data).map(|hint| hint.version))
+}
+
+/// Read the latest committed configuration for a system-controlled (`delta.*`) domain.
+///
+/// The kernel's public domain accessor rejects system domains, so the committed
+/// state is replayed here: JSON commits are scanned from the snapshot version
+/// back to the last checkpoint, whose parquet parts hold the surviving entries.
+async fn committed_domain_configuration(
+    snapshot: &EagerSnapshot,
+    log_store: &dyn LogStore,
+    domain: &str,
+) -> DeltaResult<Option<String>> {
+    let checkpoint_version = last_checkpoint_version(log_store).await?;
+    let mut cursor = snapshot.version();
+    loop {
+        if checkpoint_version.is_some_and(|version| cursor <= version) {
+            break;
+        }
+        if let Some(bytes) = log_store.read_commit_entry(cursor).await? {
+            let mut configuration = None;
+            for action in get_actions(cursor, &bytes)? {
+                if let Action::DomainMetadata(action) = action {
+                    if action.domain == domain {
+                        configuration = Some((!action.removed).then_some(action.configuration));
+                    }
+                }
+            }
+            if let Some(configuration) = configuration {
+                return Ok(configuration);
+            }
+        }
+        if cursor == 0 {
+            return Ok(None);
+        }
+        cursor -= 1;
+    }
+    match checkpoint_version {
+        Some(version) => checkpoint_domain_configuration(log_store, version, domain).await,
+        None => Ok(None),
+    }
+}
+
+async fn checkpoint_domain_configuration(
+    log_store: &dyn LogStore,
+    version: Version,
+    domain: &str,
+) -> DeltaResult<Option<String>> {
+    use arrow_array::{Array as _, BooleanArray, StringArray, StructArray};
+
+    let prefix = format!("{version:020}.checkpoint.");
+    let log_path = log_store.log_path().clone();
+    let mut parts: Vec<_> = log_store
+        .object_store()
+        .list(Some(&log_path))
+        .try_filter_map(|meta| {
+            let name = meta.location.filename().unwrap_or_default().to_owned();
+            std::future::ready(Ok(
+                (name.starts_with(&prefix) && name.ends_with(".parquet"))
+                    .then_some(meta.location),
+            ))
+        })
+        .try_collect()
+        .await?;
+    parts.sort();
+    for part in parts {
+        let reader =
+            crate::logstore::parquet_reader::ParquetObjectReader::new(log_store.object_store(), part);
+        let stream = parquet::arrow::async_reader::ParquetRecordBatchStreamBuilder::new(reader)
+            .await?
+            .build()?;
+        let batches = stream.try_collect::<Vec<_>>().await?;
+        for batch in batches {
+            let Some(column) = batch.column_by_name("domainMetadata") else {
+                continue;
+            };
+            let Some(entries) = column.as_any().downcast_ref::<StructArray>() else {
+                continue;
+            };
+            let domains = entries
+                .column_by_name("domain")
+                .and_then(|column| column.as_any().downcast_ref::<StringArray>());
+            let configurations = entries
+                .column_by_name("configuration")
+                .and_then(|column| column.as_any().downcast_ref::<StringArray>());
+            let removed = entries
+                .column_by_name("removed")
+                .and_then(|column| column.as_any().downcast_ref::<BooleanArray>());
+            let (Some(domains), Some(configurations), Some(removed)) =
+                (domains, configurations, removed)
+            else {
+                continue;
+            };
+            for row in 0..entries.len() {
+                if entries.is_null(row) || removed.value(row) {
+                    continue;
+                }
+                if domains.value(row) == domain {
+                    return Ok(Some(configurations.value(row).to_owned()));
+                }
+            }
+        }
+    }
+    Ok(None)
+}
