+"""Behavioral coverage of enablement and the native tracked read bindings."""
+
+import hashlib
+import json
+import pathlib
+import shutil
+import subprocess
+import sys
+from collections import Counter
+
+import pyarrow as pa
+import pyarrow.compute as pc
+import pytest
+
+from deltalake import CommitProperties, DeltaTable, write_deltalake
+from deltalake.exceptions import DeltaError, DeltaProtocolError
+from deltalake.transaction import PostCommitHookProperties
+
+pytestmark = pytest.mark.pyarrow
+
+ROW_ID = "__delta_row_id"
+ROW_VERSION = "__delta_row_commit_version"
+METADATA = [ROW_ID, ROW_VERSION]
+
+
+@pytest.fixture
+def row_table(tmp_path: pathlib.Path) -> DeltaTable:
+    write_deltalake(
+        tmp_path,
+        pa.table(
+            {
+                "value": pa.array([10, 10, None, 40, 50], type=pa.int64()),
+                "label": ["same", "same", None, "tail", "tail"],
+                "active": [True, True, None, False, True],
+            }
+        ),
+    )
+    return DeltaTable(tmp_path)
+
+
+def tracked(table: DeltaTable, **kwargs) -> pa.Table:
+    return table.to_pyarrow_table(
+        engine="datafusion", include_row_tracking=True, **kwargs
+    )
+
+
+def by_id(table: pa.Table) -> list[dict]:
+    return table.sort_by(ROW_ID).to_pylist()
+
+
+def assert_metadata(table: pa.Table) -> None:
+    assert table.column_names[-2:] == METADATA
+    for name in METADATA:
+        assert table.schema.field(name).type == pa.int64()
+        assert not table.schema.field(name).nullable
+        assert table[name].null_count == 0
+    ids = table[ROW_ID].to_pylist()
+    assert len(set(ids)) == len(ids)
+    assert all(value >= 0 for value in ids)
+
+
+def test_enable_updates_same_handle_without_rewriting_files(row_table, tmp_path):
+    ordinary = row_table.to_pyarrow_table(engine="datafusion")
+    files = {
+        path.relative_to(tmp_path): hashlib.sha256(path.read_bytes()).digest()
+        for path in tmp_path.rglob("*.parquet")
+    }
+    version = row_table.version()
+    assert row_table.alter.enable_row_tracking() is None
+    assert row_table.version() == version + 1
+    assert row_table.metadata().configuration["delta.enableRowTracking"] == "true"
+    assert row_table.protocol().min_writer_version == 7
+    assert {"rowTracking", "domainMetadata"}.issubset(
+        row_table.protocol().writer_features
+    )
+    assert files == {
+        path.relative_to(tmp_path): hashlib.sha256(path.read_bytes()).digest()
+        for path in tmp_path.rglob("*.parquet")
+    }
+    result = tracked(row_table)
+    assert_metadata(result)
+    assert result.column_names == ordinary.column_names + METADATA
+    assert Counter(
+        tuple(row.values()) for row in result.select(ordinary.column_names).to_pylist()
+    ) == Counter(tuple(row.values()) for row in ordinary.to_pylist())
+    assert set(result[ROW_VERSION].to_pylist()) == {row_table.version()}
+    assert by_id(tracked(DeltaTable(tmp_path))) == by_id(result)
+    assert (
+        row_table.to_pyarrow_table(engine="datafusion").column_names
+        == ordinary.column_names
+    )
+
+
+def test_enable_is_idempotent(row_table):
+    row_table.alter.enable_row_tracking()
+    before = tracked(row_table)
+    version = row_table.version()
+    row_table.alter.enable_row_tracking()
+    assert row_table.version() == version
+    assert by_id(tracked(row_table)) == by_id(before)
+
+
+def test_commit_metadata_and_post_commit_hook_are_forwarded(row_table, tmp_path):
+    row_table.alter.set_table_properties({"delta.checkpointInterval": "1"})
+    row_table.alter.enable_row_tracking(
+        commit_properties=CommitProperties(
+            custom_metadata={"trackingTest": {"enabled": True}}, max_commit_retries=0
+        ),
+        post_commithook_properties=PostCommitHookProperties(
+            create_checkpoint=False, cleanup_expired_logs=False
+        ),
+    )
+    log = tmp_path / "_delta_log" / f"{row_table.version():020}.json"
+    actions = [json.loads(line) for line in log.read_text().splitlines()]
+    commit = next(action["commitInfo"] for action in actions if "commitInfo" in action)
+    assert commit["trackingTest"] == {"enabled": True}
+    assert not log.with_suffix(".checkpoint.parquet").exists()
+
+
+@pytest.mark.parametrize("columns", [None, ["label", "value"], [], ["active"]])
+@pytest.mark.parametrize(
+    "filters",
+    [None, "value >= 40", [("value", ">=", 40)], [("value", "=", None)], "FALSE"],
+)
+def test_projection_filters_and_empty_results_preserve_native_metadata(
+    row_table, columns, filters
+):
+    row_table.alter.enable_row_tracking()
+    complete = tracked(row_table)
+    if filters is None:
+        expected = complete
+    elif filters == "FALSE":
+        expected = complete.slice(0, 0)
+    elif filters == [("value", "=", None)]:
+        expected = complete.filter(pc.is_null(complete["value"]))
+    else:
+        expected = complete.filter(pc.greater_equal(complete["value"], 40))
+    selected = complete.column_names[:-2] if columns is None else columns
+    result = tracked(row_table, columns=columns, filters=filters)
+    assert_metadata(result)
+    assert result.column_names == selected + METADATA
+    assert by_id(result) == by_id(expected.select(selected + METADATA))
+
+
+def test_raw_native_binding_agrees_with_public_read(row_table):
+    row_table.alter.enable_row_tracking()
+    native = pa.RecordBatchReader.from_stream(
+        row_table._table.scan(
+            columns=["label"], predicate="value >= 40", include_row_tracking=True
+        )
+    ).read_all()
+    public = tracked(row_table, columns=["label"], filters="value >= 40")
+    assert_metadata(native)
+    assert by_id(native) == by_id(public)
+
+
+def test_unenabled_tracking_fails_and_ordinary_reads_remain_usable(row_table):
+    version = row_table.version()
+    with pytest.raises(DeltaError):
+        tracked(row_table)
+    with pytest.raises(DeltaError):
+        row_table._table.scan(include_row_tracking=True)
+    assert row_table.version() == version
+    assert row_table.to_pyarrow_table(engine="datafusion").num_rows == 5
+
+
+@pytest.mark.parametrize("engine", ["pyarrow", "unknown"])
+def test_tracking_requires_supported_engine(row_table, engine):
+    with pytest.raises(ValueError):
+        row_table.to_pyarrow_table(engine=engine, include_row_tracking=True)
+
+
+@pytest.mark.parametrize("value", [None, 0, 1, "true", [], {}])
+def test_include_row_tracking_requires_bool(row_table, value):
+    with pytest.raises(TypeError, match="include_row_tracking"):
+        row_table.to_pyarrow_table(engine="datafusion", include_row_tracking=value)
+
+
+def test_new_options_are_keyword_only(row_table):
+    with pytest.raises(TypeError):
+        row_table.alter.enable_row_tracking(None)
+    with pytest.raises(TypeError):
+        row_table.to_pyarrow_table(None, None, None, None, "datafusion", True)
+
+
+@pytest.mark.parametrize("option", ["commit_properties", "post_commithook_properties"])
+def test_enable_rejects_invalid_properties_without_committing(row_table, option):
+    version = row_table.version()
+    with pytest.raises(TypeError, match=option):
+        row_table.alter.enable_row_tracking(**{option: {}})
+    assert row_table.version() == version
+    assert DeltaTable(row_table.table_uri).version() == version
+
+
+@pytest.mark.parametrize("name", METADATA)
+def test_reserved_user_columns_reject_enablement_without_committing(tmp_path, name):
+    write_deltalake(tmp_path, pa.table({name: pa.array([1, 2], type=pa.int64())}))
+    table = DeltaTable(tmp_path)
+    version = table.version()
+    with pytest.raises(DeltaProtocolError):
+        table.alter.enable_row_tracking()
+    assert table.version() == version
+    assert DeltaTable(tmp_path).version() == version
+    assert table.to_pyarrow_table(engine="datafusion")[name].to_pylist() == [1, 2]
+
+
+@pytest.mark.parametrize("name", METADATA)
+def test_metadata_is_not_a_user_projection(row_table, name):
+    row_table.alter.enable_row_tracking()
+    with pytest.raises(ValueError, match="user columns"):
+        tracked(row_table, columns=[name])
+
+
+def test_empty_enablement_and_creation_configuration(tmp_path):
+    schema = pa.schema([pa.field("value", pa.int64())])
+    empty = DeltaTable.create(tmp_path / "empty", schema=schema)
+    empty.alter.enable_row_tracking()
+    result = tracked(empty)
+    assert_metadata(result)
+    assert result.num_rows == 0
+    created_path = tmp_path / "configured"
+    write_deltalake(
+        created_path,
+        pa.table({"value": pa.array([1, 1], type=pa.int64())}),
+        configuration={"delta.enableRowTracking": "true"},
+    )
+    created = DeltaTable(created_path)
+    result = tracked(created)
+    assert_metadata(result)
+    assert result.num_rows == 2
+    assert set(result[ROW_VERSION].to_pylist()) == {created.version()}
+
+
+def test_update_append_and_historical_snapshot(row_table):
+    row_table.alter.enable_row_tracking()
+    original = tracked(row_table)
+    enabled_version = row_table.version()
+    row_table.update(updates={"value": "value"}, predicate="value = 10")
+    updated = tracked(row_table)
+    before = {row[ROW_ID]: row for row in original.to_pylist()}
+    for row in updated.to_pylist():
+        old = before[row[ROW_ID]]
+        assert row["value"] == old["value"]
+        assert row[ROW_VERSION] == (
+            row_table.version() if old["value"] == 10 else old[ROW_VERSION]
+        )
+    write_deltalake(
+        row_table,
+        pa.table({"value": [10], "label": ["same"], "active": [True]}),
+        mode="append",
+    )
+    row_table.update_incremental()
+    appended = tracked(row_table)
+    assert_metadata(appended)
+    new_rows = [row for row in appended.to_pylist() if row[ROW_ID] not in before]
+    assert len(new_rows) == 1
+    assert new_rows[0][ROW_VERSION] == row_table.version()
+    assert by_id(
+        appended.filter(pc.is_in(appended[ROW_ID], value_set=updated[ROW_ID]))
+    ) == by_id(updated)
+    historical = DeltaTable(row_table.table_uri, version=enabled_version)
+    assert by_id(tracked(historical)) == by_id(original)
+
+
+def test_checkpoint_copy_and_fresh_process_reopen(row_table, tmp_path):
+    row_table.alter.enable_row_tracking()
+    expected = by_id(tracked(row_table))
+    row_table.create_checkpoint()
+    copied = tmp_path.parent / f"{tmp_path.name}-relocated"
+    shutil.copytree(tmp_path, copied)
+    shutil.rmtree(tmp_path)
+    script = """
+import json
+import sys
+from deltalake import DeltaTable
+table = DeltaTable(sys.argv[1]).to_pyarrow_table(
+    engine="datafusion", include_row_tracking=True
+)
+print(json.dumps(table.sort_by("__delta_row_id").to_pylist()))
+"""
+    process = subprocess.run(
+        [sys.executable, "-c", script, str(copied)],
+        check=True,
+        capture_output=True,
+        text=True,
+        timeout=30,
+    )
+    assert json.loads(process.stdout) == expected
+
+
+@pytest.mark.parametrize(
+    "fixture, column, filters",
+    [
+        (
+            "table_with_column_mapping",
+            "Super Name",
+            [("Company Very Short", "=", "BME")],
+        ),
+        ("table-with-dv-small", "value", [("value", ">=", 4)]),
+    ],
+)
+def test_existing_mapped_and_dv_tables_keep_metadata_aligned(
+    tmp_path, fixture, column, filters
+):
+    source = (
+        pathlib.Path(__file__).parents[2]
+        / "crates"
+        / "test"
+        / "tests"
+        / "data"
+        / fixture
+    )
+    destination = tmp_path / "table"
+    shutil.copytree(source, destination)
+    table = DeltaTable(destination)
+    ordinary = table.to_pyarrow_table(
+        engine="datafusion", columns=[column], filters=filters
+    )
+    table.alter.enable_row_tracking()
+    full = tracked(table)
+    result = tracked(table, columns=[column], filters=filters)
+    assert_metadata(result)
+    assert Counter(result[column].to_pylist()) == Counter(ordinary[column].to_pylist())
+    matching = {
+        row[column]: (row[ROW_ID], row[ROW_VERSION]) for row in full.to_pylist()
+    }
+    assert all(
+        (row[ROW_ID], row[ROW_VERSION]) == matching[row[column]]
+        for row in result.to_pylist()
+    )
