+    def test_cross_team_hires_use_isolated_slates_not_shared_pool(self, coach_hire_db):
+        _import_coach_candidate_model()
+        from database.models import Coach as DBCoach
+
+        data = coach_hire_db
+        season = data["season"]
+        small, mega = data["teams"]
+        session = data["session_factory"]()
+        try:
+            small_cands = _generate_team_hire_slate(
+                data["team_manager"], small, season, session=session
+            )
+            mega_cands = _generate_team_hire_slate(
+                data["team_manager"], mega, season, session=session
+            )
+            session.flush()
+            small_pick = small_cands[0]
+            mega_pick = mega_cands[0]
+            gm = _gm_with_votes(
+                {
+                    small.id: [_fake_vote(small_pick.coach_id, 3)],
+                    mega.id: [_fake_vote(mega_pick.coach_id, 3)],
+                    "_session": session,
+                }
+            )
+            gm.resolveHireCoachVotes(
+                data["teams"],
+                season,
+                data["team_manager"],
+                {small.id, mega.id},
+            )
+            session.commit()
+            small_hired = (
+                session.query(DBCoach).filter_by(team_id=small.id).one().id
+            )
+            mega_hired = session.query(DBCoach).filter_by(team_id=mega.id).one().id
+        finally:
+            session.close()
+
+        assert small_hired == small_pick.coach_id
+        assert mega_hired == mega_pick.coach_id
+        assert small_hired != mega_hired
+
+    def test_resolver_does_not_use_league_wide_unassigned_pool(self, coach_hire_db, monkeypatch):
+        data = coach_hire_db
+        team = data["teams"][0]
+        season = data["season"]
+        session = data["session_factory"]()
+
+        def _forbidden_global_pool(*_args, **_kwargs):
+            raise AssertionError(
+                "hire_coach resolution must not walk the league-wide unassigned coach pool"
+            )
+
+        monkeypatch.setattr(
+            data["team_manager"], "getAvailableCoaches", _forbidden_global_pool
+        )
+        try:
+            cands = _generate_team_hire_slate(
+                data["team_manager"], team, season, session=session
+            )
+            session.flush()
+            gm = _gm_with_votes(
+                {team.id: [_fake_vote(cands[0].coach_id, 2)], "_session": session}
+            )
+            gm.resolveHireCoachVotes(
+                data["teams"], season, data["team_manager"], {team.id}
+            )
+            from database.models import Coach as DBCoach
+
+            session.flush()
+            hired = session.query(DBCoach).filter_by(team_id=team.id).first()
+        finally:
+            session.close()
+
+        assert hired is not None
+        assert hired.id == cands[0].coach_id
+
+    def test_clear_coach_candidates_drops_losers(self, coach_hire_db):
+        CoachCandidate = _import_coach_candidate_model()
+        data = coach_hire_db
+        team = data["teams"][0]
