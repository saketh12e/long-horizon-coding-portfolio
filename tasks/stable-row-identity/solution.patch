+pub(crate) async fn prepare_commit_actions(
+    snapshot: Option<&EagerSnapshot>,
+    log_store: &dyn LogStore,
+    actions: &mut Vec<Action>,
+    version: Version,
+) -> DeltaResult<bool> {
+    let protocol = protocol_with_features(snapshot, actions);
+    let metadata = metadata_with_names(snapshot, actions);
+    let supported_before = snapshot.is_some_and(|snapshot| is_supported(snapshot.protocol()));
+    let supported_after = protocol.as_ref().is_some_and(is_supported);
+    if supported_before && !supported_after {
+        return Err(invalid("dropping row tracking is not supported"));
+    }
+
+    let enabled_before = snapshot.is_some_and(|snapshot| is_enabled(snapshot.table_properties()));
+    let enabled_after = match &metadata {
+        Some(metadata) => configured_bool(metadata, ENABLE_ROW_TRACKING)?.unwrap_or(enabled_before),
+        None => enabled_before,
+    };
+    if enabled_before && !enabled_after {
+        return Err(invalid("disabling row tracking is not supported"));
+    }
+
+    let suspended_after = match &metadata {
+        Some(metadata) => configured_bool(metadata, ROW_TRACKING_SUSPENDED)?.unwrap_or(false),
+        None => false,
+    };
+    if suspended_after {
+        return Err(invalid("suspending row tracking is not supported"));
+    }
+    if !supported_after {
+        return Ok(false);
+    }
+    if let Some(protocol) = &protocol {
+        if protocol.min_writer_version() != 7
+            || !protocol
+                .writer_features()
+                .is_some_and(|features| features.contains(&TableFeature::DomainMetadata))
+        {
+            return Err(invalid(
+                "row tracking requires writer version 7 and domainMetadata",
+            ));
+        }
+    }
+    if enabled_before {
+        if let (Some(snapshot), Some(metadata)) = (snapshot, metadata.as_ref()) {
+            for property in [
+                MATERIALIZED_ROW_ID_COLUMN,
+                MATERIALIZED_ROW_COMMIT_VERSION_COLUMN,
+            ] {
+                if snapshot.metadata().configuration().get(property)
+                    != metadata.configuration().get(property)
+                {
+                    return Err(invalid(
+                        "materialized row tracking column names are immutable",
+                    ));
+                }
+            }
+        }
+    }
+    if enabled_after {
+        let metadata = metadata
+            .as_ref()
+            .ok_or_else(|| invalid("row tracking enablement requires table metadata"))?;
+        validate_schema(metadata)?;
+        if !enabled_before {
+            let properties = snapshot
+                .map(|snapshot| snapshot.table_properties().clone())
+                .unwrap_or_default();
+            materialized_column_names(&properties).or_else(|_| {
+                let row_id = metadata
+                    .configuration()
+                    .get(MATERIALIZED_ROW_ID_COLUMN)
+                    .map(String::as_str);
+                let version = metadata
+                    .configuration()
+                    .get(MATERIALIZED_ROW_COMMIT_VERSION_COLUMN)
+                    .map(String::as_str);
+                match (row_id, version) {
+                    (Some(row_id), Some(version))
+                        if !row_id.is_empty() && !version.is_empty() && row_id != version =>
+                    {
+                        Ok((row_id, version))
+                    }
+                    _ => Err(invalid(
+                        "row tracking enablement requires distinct materialized column names",
+                    )),
+                }
+            })?;
+        }
+    }
+
+    if enabled_after && !enabled_before {
+        if let Some(snapshot) = snapshot {
+            backfill_active_files(snapshot, log_store, actions).await?;
+        }
+    }
+
+    let domain_configuration = match snapshot {
+        Some(snapshot) => {
+            committed_domain_configuration(snapshot, log_store, ROW_TRACKING_DOMAIN).await?
+        }
+        None => None,
+    };
+    let domain_present = domain_configuration.is_some();
+    let mut previous_hwm = domain_configuration
+        .map(|configuration| {
+            serde_json::from_str::<RowTrackingDomainConfiguration>(&configuration)
+                .map(|domain| domain.row_id_high_water_mark)
+                .map_err(|err| invalid(format!("invalid row tracking domain metadata: {err}")))
+        })
+        .transpose()?
+        .unwrap_or(-1);
+    if previous_hwm < -1 {
+        return Err(invalid("row ID high-water mark is below -1"));
+    }
+    let initial_hwm = previous_hwm;
+    let commit_version = i64::try_from(version)
+        .map_err(|_| invalid("commit version does not fit the row commit version type"))?;
+    let had_domain_action = actions
+        .iter()
+        .any(|action| matches!(action, Action::DomainMetadata(domain) if domain.domain == ROW_TRACKING_DOMAIN));
+    actions.retain(|action| {
+        !matches!(action, Action::DomainMetadata(domain) if domain.domain == ROW_TRACKING_DOMAIN)
+    });
+
+    for action in actions.iter_mut() {
+        let Action::Add(add) = action else {
+            continue;
+        };
+        let count = num_records(add)?;
+        if add.base_row_id.is_some_and(|base| base < 0) {
+            return Err(invalid("baseRowId must be nonnegative"));
+        }
+        if add.base_row_id.is_none() {
+            let count = match count {
+                Some(count) => count,
+                None => records_for_allocation(add, log_store).await?,
+            };
+            let base = previous_hwm
+                .checked_add(1)
+                .ok_or_else(|| invalid("row ID high-water mark overflow"))?;
+            add.base_row_id = Some(base);
+            advance_high_water_mark(&mut previous_hwm, count)?;
+        } else if let (Some(base), Some(count)) = (add.base_row_id, count) {
+            if count > 0 {
+                let highest = base
+                    .checked_add(count - 1)
+                    .ok_or_else(|| invalid("row ID range overflow"))?;
+                previous_hwm = previous_hwm.max(highest);
+            }
+        }
+        if add.default_row_commit_version.is_none() {
+            add.default_row_commit_version = Some(commit_version);
+        }
+    }
+
+    if previous_hwm != initial_hwm || !domain_present || had_domain_action {
+        actions.push(Action::DomainMetadata(DomainMetadata {
+            domain: ROW_TRACKING_DOMAIN.to_owned(),
+            configuration: format!("{{\"rowIdHighWaterMark\":{previous_hwm}}}"),
+            removed: false,
+        }));
+    }
+    Ok(true)
+}
+
+pub(crate) async fn commit_failpoint(
+    phase: &str,
+    version: Version,
+    attempt: usize,
+) -> DeltaResult<()> {
+    let Ok(root) = std::env::var(FAILPOINT_ENV) else {
+        return Ok(());
+    };
+    let root = std::path::PathBuf::from(root);
+    std::fs::create_dir_all(&root)?;
+    let stem = format!("{phase}-{version:020}-{attempt:02}");
+    std::fs::write(root.join(format!("{stem}.ready")), b"")?;
+    let release = root.join(format!("{stem}.release"));
+    let deadline = Instant::now() + Duration::from_secs(60);
+    while !release.exists() {
+        if Instant::now() >= deadline {
+            return Err(invalid(format!(
+                "timed out waiting for row tracking failpoint release {}",
+                release.display()
+            )));
+        }
+        tokio::time::sleep(Duration::from_millis(10)).await;
+    }
+    Ok(())
+}
